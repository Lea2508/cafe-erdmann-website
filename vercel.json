{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cafe-erdmann.de" }],
      "destination": "https://cafe-erdmann.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cafe-erdmann.de" }],
      "destination": "https://cafe-erdmann.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cafe-erdmann.com" }],
      "destination": "https://cafe-erdmann.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/menu",
      "destination": "/restaurant.html#menu",
      "statusCode": 308
    },
    {
      "source": "/menu.html",
      "destination": "/restaurant.html#menu",
      "statusCode": 308
    },
    {
      "source": "/bachstube",
      "destination": "/backstube.html",
      "statusCode": 308
    },
    {
      "source": "/bachstube.html",
      "destination": "/backstube.html",
      "statusCode": 308
    }
  ]
}
